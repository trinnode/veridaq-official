{
  "name": "veridaq",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "private": true,
  "description": "Privacy-preserving academic credential verification using ZKPs on Base.",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "tsx watch packages/backend/src/server.ts",
    "dev:frontend": "next dev packages/frontend --port 3000",
    "simulate:role-flow": "tsx packages/backend/src/scripts/simulate-role-flow.ts",
    "build:backend": "tsc -p packages/backend/tsconfig.json",
    "build:frontend": "pnpm extension:zip && next build packages/frontend",
    "test:backend": "vitest run --config packages/backend/vitest.config.ts",
    "test:contracts": "cd packages/contracts && forge test -vvv",
    "test:contracts:coverage": "cd packages/contracts && forge coverage",
    "lint": "eslint packages/backend/src packages/frontend/app packages/frontend/components packages/frontend/lib --ext .ts,.tsx",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/backend/tsconfig.json --noEmit && tsc -p packages/frontend/tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema packages/backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/backend/prisma/schema.prisma",
    "db:seed": "tsx packages/backend/prisma/seed.ts",
    "db:studio": "prisma studio --schema packages/backend/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema packages/backend/prisma/schema.prisma",
    "circuit:compile": "bash packages/circuits/scripts/compile.sh",
    "circuit:setup": "bash packages/circuits/scripts/setup.sh",
    "contracts:deploy": "cd packages/contracts && forge script script/Deploy.s.sol --rpc-url base_sepolia --broadcast --verify",
    "contracts:deploy:dry": "cd packages/contracts && forge script script/Deploy.s.sol --rpc-url base_sepolia",
    "prepare": "husky",
    "extension:zip": "mkdir -p packages/frontend/public/extension packages/extension/dist && cp packages/extension/manifest.json packages/extension/background.js packages/extension/content.js packages/extension/popup.html packages/extension/panel.html packages/extension/ui.js packages/extension/config.js packages/extension/styles.css packages/extension/panel.css packages/extension/icon.svg packages/extension/dist/ && cd packages/extension/dist && zip -r ../../frontend/public/extension/VERIDAQ-Companion.zip . && cd .. && rm -rf dist"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/qr-image": "^3.2.11",
    "@types/three": "^0.185.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.9",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@studio-freight/lenis": "^1.0.42",
    "@tanstack/react-query": "^5.75.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.49.4",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.1.0",
    "fastify-sse-v2": "^4.2.2",
    "ffjavascript": "^0.3.1",
    "framer-motion": "^12.12.1",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.18.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.3",
    "prisma": "^6.8.2",
    "qr-image": "3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.56.3",
    "recharts": "^2.15.3",
    "snarkjs": "^0.7.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "three": "^0.185.1",
    "tsx": "^4.19.4",
    "viem": "^2.34.0",
    "vitest": "^3.1.4",
    "wagmi": "^2.12.4",
    "zod": "^3.24.4",
    "zustand": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
