# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_this_with_a_very_long_random_string
JWT_EXPIRES_IN=15m
REFRESH_SECRET=replace_this_with_another_very_long_random_string
REFRESH_EXPIRES_IN=7d
EXTENSION_JWT_EXPIRES_IN=5m

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://veridaq:veridaq_dev@localhost:5432/veridaq

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Alchemy ──────────────────────────────────────────────────
# Get from: https://dashboard.alchemy.com
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_BASE_SEPOLIA_URL=https://base-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here

# ── Contracts ────────────────────────────────────────────────
# Deployed contract addresses (filled after running deploy script)
INSTITUTION_REGISTRY_ADDRESS=
CREDENTIAL_REGISTRY_ADDRESS=
REVOCATION_REGISTRY_ADDRESS=
PAYMASTER_VAULT_ADDRESS=
SUBSCRIPTION_MANAGER_ADDRESS=
ZK_VERIFIER_ADDRESS=

# ERC-4337 EntryPoint on Base Sepolia (do not change)
ENTRY_POINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# ERC-4337 Bundler and SimpleAccount
BUNDLER_RPC_URL=
AA_SIMPLE_ACCOUNT_FACTORY_ADDRESS=
AA_SIMPLE_ACCOUNT_OWNER_PRIVATE_KEY=
AA_SIMPLE_ACCOUNT_SALT=0

# ── Signing ──────────────────────────────────────────────────
# The platform admin's private key — for deploying contracts and
# performing admin on-chain actions. NEVER commit this.
PLATFORM_ADMIN_PRIVATE_KEY=0xyour_private_key_here
PLATFORM_ADMIN_ADDRESS=0xyour_public_address_here

# ── Circuits ─────────────────────────────────────────────────
# Path to the compiled proving key (relative to workspace root, or absolute).
# After running `pnpm circuit:setup` these files will be at:
CIRCUIT_ZKEY_PATH=packages/circuits/build/credential_final.zkey
CIRCUIT_WASM_PATH=packages/circuits/build/credential_js/credential.wasm
# Docker / production override (uncomment when running inside the container):
# CIRCUIT_ZKEY_PATH=/app/packages/circuits/build/credential_final.zkey
# CIRCUIT_WASM_PATH=/app/packages/circuits/build/credential_js/credential.wasm

# ── Encryption ───────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of credential plaintext
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_chars_openssl_rand_hex_32

# ── Email ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@veridaq.xyz
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=VERIDAQ <notifications@veridaq.xyz>

# ── Basescan (for contract verification) ─────────────────────
BASESCAN_API_KEY=your_basescan_api_key

# Extension allowed origins, comma separated
EXTENSION_ORIGINS=

# ── Crossmint ────────────────────────────────────────────────
# Crossmint handles fiat-to-crypto on-ramp for all platform payments.
# Get keys from: https://dashboard.crossmint.com
CROSSMINT_SERVER_API_KEY=your_crossmint_server_api_key
CROSSMINT_WEBHOOK_SECRET=your_crossmint_webhook_secret

# ── Frontend (Next.js public env) ────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID=84532
